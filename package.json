{
  "name": "pdv-facil",
  "version": "1.0.0",
  "description": "PDV Fácil - aplicativo para Windows",
  "author": "PDV Fácil",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pdvfacil.app",
    "productName": "PDV Fácil",
    "artifactName": "PDV-Facil-Instalador.${ext}",
    "files": [
      "main.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDV Fácil",
      "language": "1046"
    }
  }
}
